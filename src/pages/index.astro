const currentState =
	"Open to junior roles and internships in Valencia or remote";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<header>
		<nav>
			<a href="#about">
				<small>ABOUT</small>
			</a>
			<a href="#experience">
				<small>EXPERIENCE</small>
			</a>
			<a href="#projects">
				<small>PROJECTS</small>
			</a>
			<a href="#connect">
				<small>CONNECT</small>
			</a>
		</nav>
	</header>
	<SectionMain>
		<div class="about-me" id="about">
			<AboutTopContent />
			<p>
				I’m Guillermo Mora Mortes, a full-stack developer based in
				Valencia. I build useful, accessible software end to end, from
				the interface to the system running behind it.
			</p>
			<hr />
			<p>
				Creative by nature and a Linux <Image
					src={tuxImg}
					alt="TUX"
					loading="eager"
				/> and servers enthusiast (I host my own at home :D), I like to understand
				how things work, and then make them feel like mine.
			</p>
			<div class="spoken-languages">
				<div></div>
				<span>
					I speak Spanish and Catalan natively, and English at an
					advanced level.
				</span>
			</div>
			<CurrentState text={currentState} />
		</div>
		<Stack groups={stack} note="" />
		<Experience experiences={experiences} />
	</SectionMain>
	<SectionProjects projects={projects} />
	<SectionFinal>
		<Education educations={educations} />
		<Contact contacts={contacts} />
	</SectionFinal>
</Layout>

<style>
	.spoken-languages {
		display: flex;
		flex-direction: row;
		gap: 16px;
		margin-bottom: 16px;
		div {
			flex-shrink: 0;
			margin-top: 5px;
			width: 8px;
			height: 8px;
			background-color: var(--c2);
			box-shadow: 3px 3px 0 0 var(--c4);
		}
	}
	.about-me {
		margin-top: 53px;
	}
	hr {
		width: 75px;
		border: 4px solid var(--c2);
		box-shadow: 4px 4px 0 0 var(--c4);
	}
	header {
		position: fixed;
		inset: 0px 0px auto 0px;
		width: auto;
		margin: 16px 16px;
		background-color: var(--c4);
		box-shadow: 4px 4px 0 0 var(--c2);
		display: flex;
		align-items: center;
		justify-content: center;
		nav {
			margin: 16px 0;
			padding: 0 16px;
			max-width: 700px;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-direction: row;
			gap: 1.5rem;
			small {
				font-size: 0.75rem;
			}
			a,
			a:visited {
				color: inherit;
				text-decoration: none;
			}
		}
	}
</style>

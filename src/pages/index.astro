// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<header>
		<nav>
			<a href="#about">
				<small>ABOUT</small>
			</a>
			<a href="#experience">
				<small>EXPERIENCE</small>
			</a>
			<a href="#projects">
				<small>PROJECTS</small>
			</a>
			<a href="#connect">
				<small>CONNECT</small>
			</a>
		</nav>
	</header>
	<SectionMain>
		<div class="about-me" id="about">
			<AboutTopContent />
			<p>
				I'm Guillermo Mora Mortes, a software developer based in
				Valencia.
				<br />
				I build full-stack applications focused on creating useful, accessible
				software for everyone.
			</p>
			<hr />
			<p>
				I'm passionate about building software that people actually use
				— and I bring a creative approach to everything I make.
			</p>
		</div>
		<Experience experiences={experiences}/>
	</SectionMain>
	<!--Hacer transición de entrada con degradado de pixeles creada con css-->
	<SectionProjects>
		<div style="height: 300px;"></div>
	</SectionProjects>
	<!--Hacer transición de salida con degradado de pixeles creada con css-->
	<SectionFinal>
		<Education educations={educations} />
		<Contact contacts={contacts} />
	</SectionFinal>
</Layout>

<style>
	.about-me {
		margin-top: 53px;
	}
	hr {
		width: 75px;
		border: 4px solid var(--c2);
		box-shadow: 4px 4px 0 0 var(--c4);
	}
	header {
		position: fixed;
		inset: 0px 0px auto 0px;
		width: auto;
		margin: 16px 16px;
		background-color: var(--c4);
		box-shadow: 4px 4px 0 0 var(--c2);
		display: flex;
		align-items: center;
		justify-content: center;
		nav {
			margin: 16px 0;
			padding: 0 16px;
			max-width: 700px;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-direction: row;
			gap: 1.5rem;
			small {
				font-size: 0.75rem;
			}
			a,
			a:visited {
				color: inherit;
				text-decoration: none;
			}
		}
	}
</style>

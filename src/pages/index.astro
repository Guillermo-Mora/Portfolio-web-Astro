---
import SectionMain from "../components/SectionMain.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Contact from "../components/Contact.astro";
import Layout from "../layouts/Layout.astro";
import SectionProjects from "../components/SectionProjects.astro";
import SectionFinal from "../components/SectionFinal.astro";
import AboutTopContent from "../components/AboutTopContent.astro";
import libreGuardiaImg from "../images/Liberguardia_Project.webp";

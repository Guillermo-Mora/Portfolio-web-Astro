	},
	{
		domain: "linkedin.com",
		profile: "Guillermo-Mora",
		url: "https://www.linkedin.com/in/guillermo-mora-mortes-b071a034a/",
	},
];

const projects = [
	{
		title: "LibreGuardia",
		imageSrc: libreGuardiaImg,
		description:
			"Software for managing teacher absences and on-call duties in educational centers. Designed to centralize scheduling, track substitutions, and give staff a clear view of daily coverage needs.",

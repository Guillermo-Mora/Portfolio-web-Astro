import SectionProjects from "../components/SectionProjects.astro";
import SectionFinal from "../components/SectionFinal.astro";
import AboutTopContent from "../components/AboutTopContent.astro";

const experiences = [
	{
		role: "Full-Stack Development",
		company: "UPV",
		location: "Valencia, Spain",
		summary:
			"Designed and built a full-stack app from scratch to manage teacher absences and on-call duties for my school.",
		date: "April - June 2026",
	},
	{
		role: "Software Development & Business Intelligence",
		company: "Ahora Software",
		location: "Valencia, Spain",
		summary:
			"Worked with BI tools, databases and frontend, and built low-code applications.",
		date: "May 2025",
	},
	{
		role: "Web Development & Technical Support",
		company: "Doctor Phone",
		location: "Valencia, Spain",
		summary:
			"Built the shop's website and provided technical support: customer service, device repair and equipment maintenance.",
		date: "April - June 2024",
	},
];

const educations = [
	{
		title: "Higher FP DAM",
		place: "IES Serpis",
		location: "Valencia, Spain",
		date: "2024 - 2026",
	},
	{
		title: "Medium FP SMR",
		place: "IES Serpis",
		location: "Valencia, Spain",
		date: "2022 - 2024",
	},
	{
		title: "Obligatory Secondary Education",
		place: "IES La Patacona",
		location: "Valencia, Spain",
		date: "2017 - 2021",
	},
];

const contacts = [
	{
		profile: "guillermomora@tutamail.com",
		url: "mailto:guillermomora@tutamail.com",
	},
	{
		domain: "github.com",
		profile: "Guillermo-Mora",
		url: "https://github.com/Guillermo-Mora",
	},
	{
		domain: "linkedin.com",
		profile: "Guillermo-Mora",
		url: "https://www.linkedin.com/in/guillermo-mora-mortes-b071a034a/",
	},

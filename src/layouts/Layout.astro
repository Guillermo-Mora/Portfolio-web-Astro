---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Guillermo Mora Mortes</title>
		<script is:inline>
			(function () {
				if (sessionStorage.getItem("langRedirectDone")) return;
				const userLangs = navigator.languages || [navigator.language];
				const prefersSpanish = userLangs.some((lang) =>
					lang.toLowerCase().startsWith("es"),
				);
				const currentPath = window.location.pathname;

				if (prefersSpanish && !currentPath.startsWith("/es/")) {
					sessionStorage.setItem("langRedirectDone", "1");
					window.location.replace("/es" + currentPath);
				}
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	@font-face {
		font-family: JetBrainsMono;
		src: url(/fonts/JetBrainsMono-VariableFont_wght.ttf);
	}
	html {
		margin: 0;
		width: 100%;
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		width: 100%;
		font-family: JetBrainsMono;
		display: flex;
		flex-direction: column;
		justify-content: center;
		color: var(--c1);
	}
</style>

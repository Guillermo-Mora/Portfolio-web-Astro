---
import SectionTitle from "./SectionTitle.astro";

export interface Sta {
    title: string;
    groups: Group[];
}

interface Group {
    label: string;
    items: string[];
}

interface Props {
    stack: Sta;
}

const { stack } = Astro.props;
---

<div>
    <SectionTitle title={stack.title} />
    <div class="stack">
        {
            stack.groups.map((group) => (
                <div class="row">
                    <small class="label">{group.label}</small>
                    <ul class="tags" aria-label={group.label}>
                        {group.items.map((item) => (
                            <li>
                                <small>{item}</small>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>
</div>

<style>
    .stack {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1.25rem;
    }

    .row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.5rem 0.25rem;
        align-items: start;
    }

    .label {
        font-weight: bold;
        color: var(--c3);
    }

    .tags {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        li {
            padding: 2px 8px;
            border: 2px solid var(--c4);
            color: var(--c3);
        }
        small {
            font-size: 0.75rem;
        }
    }

    .note {
        margin-top: 0.5rem;
        font-size: 0.75rem;
        color: var(--c3);
    }
</style>

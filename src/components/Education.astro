---
import SectionTitle from "../components/SectionTitle.astro";

export interface Edu {
    title: string;
    sections: Section[];
}

interface Section {
    title: string;
    place: string;
    location: string;
    date: string;
    grade: string;
}

interface Props {
    educations: Edu;
}

const { educations } = Astro.props;
---

<div id="education">
    <SectionTitle title={educations.title} />
    <ul>
        {
            educations.sections.map((education) => (
                <li>
                    <div>
                        <div class="list-style" />
                    </div>
                    <div class="place-date">
                        <div>
                            <p>
                                {education.title}
                                <br />
                                <span class="place-text">
                                    {education.place} -
                                    <small> {education.location}</small>
                                </span>
                                <br />
                                <span>{education.grade}</span>
                            </p>
                        </div>
                        <div>
                            <small class="date-text">{education.date}</small>
                        </div>
                    </div>
                </li>
            ))
        }
    </ul>
</div>
<style>
    .place-text {
        color: var(--c3);
    }
    ul {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin: 0;
        margin-top: 1rem;
        padding: 0;
        list-style: none;
    }
    li {
        display: flex;
        flex-direction: row;
        p {
            margin: 6px 0;
        }
    }
    .list-style {
        width: 8px;
        height: 8px;
        background-color: var(--c2);
        box-shadow: 3px 3px 0 0 var(--c4);
        margin-left: 1rem;
        margin-right: 2rem;
        margin-top: 22px;
    }
    .place-date {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        gap: 20px;
    }
    .date-text {
        white-space: nowrap;
    }
    @media (max-width: 500px) {
        .place-date {
            flex-direction: column;
            gap: 0.25;
        }
    }
</style>

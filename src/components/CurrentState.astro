---
interface Props {
    text: string;
}

const {text} = Astro.props;
---

<div class="current-state">
    <small>
        {text}
    </small>
</div>
<style>
    .current-state {
        width: fit-content;
        padding: 8px;
        background-color: #0c0c0c;
        color: #cccccc;
        box-shadow: 4px 4px 0 0 var(--c4);
        border: 4px solid #3a3a3a;
        box-shadow: 4px 4px 0 0 #000000;
    }
</style>

---
const steps = ["Planning...", "Coding...", "Testing...", "Deploying..."];

// Aspecto de la barra (cámbialo aquí a tu gusto)
const BLOCKS = 4; // nº de bloques; cada bloque = 100 / BLOCKS %
const FILLED = "■";
const EMPTY = "□";
const emptyBar = `[${EMPTY.repeat(BLOCKS)}]`;
---

<div
    class="terminal"
    data-blocks={BLOCKS}
    data-filled={FILLED}
    data-empty={EMPTY}
>
    {
        steps.map((step) => (
            <div class="line">
                <span>{step}</span>
                <span class="progress">
                    <span class="bar">{emptyBar}</span>
                    <span class="pct">0%</span>
                </span>
            </div>
        ))
    }
</div>

<style>
    .terminal {
        --term-bg: #0c0c0c;
        --term-fg: #cccccc;
        --term-border: #3a3a3a;
        --term-shadow: #000000;
        font-size: 12px;
        color: var(--term-fg);
        padding: 4px;
        background-color: var(--term-bg);
        border: 4px solid var(--term-border);
        box-shadow: 4px 4px 0 0 var(--term-shadow);
        display: grid;
        grid-template-columns: max-content max-content;
        column-gap: 4px;
        justify-content: start;
        .line {
            display: contents;
            visibility: hidden;
        }
        .line.is-visible {
            visibility: visible;
        }
        .progress {
            display: flex;
            gap: 4px;
            white-space: pre;
        }
        .bar {
            white-space: pre;
        }
        .pct {
            min-width: 4ch;
            text-align: right;
        }
    }
</style>

<script>
    const FILL_MS = 3000;
    const RESTART_MS = 3000;

    const terminal = document.querySelector<HTMLElement>(".terminal");

    if (terminal) {
        const blocks = Number(terminal.dataset.blocks ?? 4);
        const filledChar = terminal.dataset.filled ?? "■";
        const emptyChar = terminal.dataset.empty ?? "□";
        const stepMs = FILL_MS / blocks;
        const lines = Array.from(
            terminal.querySelectorAll<HTMLElement>(".line"),
        );

        const wait = (ms: number) =>
            new Promise<void>((r) => setTimeout(r, ms));

        const render = (line: HTMLElement, filled: number) => {
            const bar = line.querySelector<HTMLElement>(".bar");
            const pct = line.querySelector<HTMLElement>(".pct");
            if (bar) {
                bar.textContent = `${filledChar.repeat(filled)}${emptyChar.repeat(blocks - filled)}`;
            }
            if (pct)
                pct.textContent = `${Math.round((filled / blocks) * 100)}%`;
        };

        const run = async () => {
            while (terminal.isConnected) {
                for (const line of lines) {
                    line.classList.remove("is-visible");
                    render(line, 0);
                }
                for (const line of lines) {
                    line.classList.add("is-visible");
                    for (let filled = 1; filled <= blocks; filled++) {
                        await wait(stepMs);
                        render(line, filled);
                    }
                }
                await wait(RESTART_MS);
            }
        };

        run();
    }
</script>

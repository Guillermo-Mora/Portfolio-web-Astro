---
import astroLogo from "../assets/astro.svg";
import background from "../assets/background.svg";
import SectionBase from "../components/SectionBase.astro"
---

<SectionBase class="section-main">
		<img class="img-guillermo-mora" src="src/images/guillermo-mora-mortes.jpg" alt="Guillermo Mora Mortes" />
		<p>
			I'm Guillermo Mora Mortes, a software developer based in Valencia.
		</p>
		<p>
			I build full-stack applications focused on creating useful,
			accessible software for everyone.
		</p>
</SectionBase>

<style>
	section {
		background-color: red;
	}
	.img-guillermo-mora {
		aspect-ratio: 1, 1;
		border-radius: 100%;
		max-width: 20dvw;
		height: auto;
		user-select: none;
		-webkit-user-drag: none;
	}
</style>

---
import SectionTitle from "../components/SectionTitle.astro";

interface Experience {
    role: string;
    company: string;
    location: string;
    summary: string;
    date: string;
}

interface Props {
    experiences: Experience[];
}

const { experiences } = Astro.props;
---

<div id="experience">
    <SectionTitle title="EXPERIENCE" />
    <ul>
        {
            experiences.map((experience) => (
                <li>
                    <div>
                        <div class="list-style" />
                    </div>
                    <div>
                        <div class="place-date">
                            <div>
                                <p>
                                    {experience.role}
                                    <br />
                                    <span class="place-text">
                                        {experience.company} -
                                        <small> {experience.location}</small>
                                    </span>
                                </p>
                            </div>
                            <div>
                                <small class="date-text">
                                    {experience.date}
                                </small>
                            </div>
                        </div>
                        <p>{experience.summary}</p>
                    </div>
                </li>
            ))
        }
    </ul>
</div>
<style>
    .title {
        color: var(--c2);
        font-weight: bold;
    }
    .place-text {
        color: var(--c3);
    }
    ul {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin: 0;
        margin-top: 1rem;
        padding: 0;
        list-style: none;
    }
    li {
        display: flex;
        flex-direction: row;
        p {
            margin: 6px 0;
        }
    }
    .list-style {
        width: 8px;
        height: 8px;
        background-color: var(--c2);
        box-shadow: 3px 3px 0 0 var(--c4);
        margin-left: 1rem;
        margin-right: 2rem;
        margin-top: 22px;
    }
    .place-date {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        gap: 1.25rem;
    }
    .date-text {
        white-space: nowrap;
    }
    @media (max-width: 500px) {
        .place-date{
            flex-direction: column;
            gap: 0.25;
        }
    }
</style>
